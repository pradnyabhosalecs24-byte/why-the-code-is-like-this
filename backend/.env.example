# ---------------------------------------------------------------
# TraceWhy backend configuration. Copy to `.env` and fill in.
# Never commit `.env`. All secrets stay on the backend.
# ---------------------------------------------------------------

# HTTP server
PORT=4000
# Comma-separated list of allowed browser origins (Vite dev server by default)
CORS_ORIGINS=http://localhost:5173

# Local demo mode: in-memory graph pre-loaded with the SYNTHETIC demo repository.
# Prefer `npm run demo` (sets this for you). Needs no other credentials.
DEMO_MODE=false

# Graph backend: "neo4j" (default, required for the real demo) or
# "memory" (in-process graph, useful for offline testing only; data is lost on restart)
GRAPH_BACKEND=neo4j

# Neo4j AuraDB  (Aura console -> your instance -> Connect -> Drivers)
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-your-aura-password
NEO4J_DATABASE=neo4j

# GitHub personal access token (classic or fine-grained, public repo read access is enough).
# Optional, but without it GitHub allows only 60 requests/hour.
GITHUB_TOKEN=

# LLM used to explain retrieved evidence: "sarvam", "openai" or "none".
# Leave empty to auto-select: Sarvam if SARVAM_API_KEY is set, else OpenAI if OPENAI_API_KEY is set,
# else none (deterministic, extractive answers that only restate retrieved evidence).
LLM_PROVIDER=

# Sarvam AI (https://dashboard.sarvam.ai -> API keys)
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b

# OpenAI (alternative)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Use the LLM to refine decision candidates during import (costs tokens)
OPENAI_REFINE_DECISIONS=false

# Import limits (keep small for free-tier GitHub limits and quick demos)
IMPORT_MAX_COMMITS=300
IMPORT_MAX_COMMIT_DETAILS=120
IMPORT_MAX_PULLS=60
IMPORT_MAX_ISSUES=80
IMPORT_MAX_TIMELINES=30
IMPORT_MAX_FILES=150
IMPORT_MAX_FILE_BYTES=120000

# Timeouts (ms)
GITHUB_TIMEOUT_MS=15000
OPENAI_TIMEOUT_MS=45000
