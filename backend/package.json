{
  "name": "tracewhy-backend",
  "version": "1.0.0",
  "private": true,
  "description": "TraceWhy API: reconstructs why code is the way it is from a Neo4j knowledge graph of repository history",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:integration": "node --test \"tests/integration/*.test.js\"",
    "db:init": "node scripts/initDb.js",
    "db:clear": "node scripts/clearRepo.js",
    "demo": "node scripts/demo.js",
    "seed:demo": "node scripts/seedDemo.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "neo4j-driver": "^5.28.1",
    "openai": "^4.104.0"
  }
}
